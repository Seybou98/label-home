# Connexion espace client
AUTH_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENTS_COLLECTION=clients
FIREBASE_CLIENTS_EMAIL_FIELD=contact.email

# EmailJS (envoi du code de connexion, côté serveur uniquement)
EMAILJS_SERVICE_ID_connexion=
EMAILJS_TEMPLATE_ID_connexion=
EMAILJS_USER_ID_connexion=
EMAILJS_PRIVATE_KEY_connexion=
FIREBASE_CLIENT_COLLECTIONS=clients,client_entretien
FIREBASE_SITE_CLIENTS_COLLECTION=site_clients

# Souscription de contrat d'entretien : backend du CRM (Render) et bucket Storage des contrats PDF.
# Les deux ont une valeur par défaut (backend de production / <projet>.firebasestorage.app) ; à renseigner seulement pour les surcharger.
CRM_BACKEND_URL=https://crm-back-lyvg.onrender.com
FIREBASE_STORAGE_BUCKET=
